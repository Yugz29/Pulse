# Racine du repo unique Pulse. Le .gitignore de core/ reste en place et
# s'applique sous core/ ; aucun motif n'est ancré, donc tout est couvert.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.build/
.swiftpm/
data/
*.sqlite3
*.db
.DS_Store
cortex-snapshot.json
.claude/
.gitnexus/
*.egg-info/

# outillage local (pyenv), pas un fichier du projet
.python-version

# Données de travail des audits (rejeux, sorties de modèle, taxonomies,
# audits clos) : hors dépôt, dans corpus/ à la racine. Seuls les JSON à la
# racine d'un audit encore ouvert (en attente de l'utilisateur) sont versionnés.
# Règle dans AGENTS.md, index dans docs/audits/README.md.
corpus/
docs/audits/**/*.json
!docs/audits/*/*.json
