# Racine du repo unique Pulse. Le .gitignore de core/ reste en place et
# s'applique sous core/ ; aucun motif n'est ancré, donc tout est couvert.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.build/
.swiftpm/
data/
*.sqlite3
*.db
.DS_Store
cortex-snapshot.json
.claude/
.gitnexus/
*.egg-info/

# outillage local (pyenv), pas un fichier du projet
.python-version

# Traces d'audit (rejeux, sorties de modèle, scénarios) : hors dépôt, dans
# corpus/ à la racine, même arborescence. Les tables d'analyse à la racine
# d'un audit (mesures, taxonomie, revue, empreintes) restent versionnées.
corpus/
docs/audits/**/*.json
!docs/audits/*/*.json
