        {
          "ref": "o19",
          "kind": "command",
          "at": 4581.0,
          "command": "mkdir -p ~/.config/pulse\ncat > ~/.config/pulse/llm.env <<'EOF'\nexport PULSE_LLM_BASE_URL='https://router.cogity.co/api/v1'\nexport PULSE_LLM_API_KEY=[REDACTED]\nexport PULSE_LLM_MODEL='claude-sonnet-5'\nEOF\nchmod 600 ~/.config/pulse/llm.env",
